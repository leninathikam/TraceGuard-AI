# Nebius Token Factory API key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
# NVIDIA open model used for diagnosis. Must be served by Token Factory.
TRACEGUARD_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA fallback model when primary model fails or deprecates (Nov 9 deprecation)
TRACEGUARD_FALLBACK_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# subprocess (default) or docker (no network, read-only rootfs, resource limits)
# TRACEGUARD_SANDBOX=subprocess
